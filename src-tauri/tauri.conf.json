{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Document Translator",
  "version": "0.1.0",
  "identifier": "com.baka.local-document-translator",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Local Document Translator",
        "width": 1160,
        "height": 800,
        "minWidth": 840,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://localhost:*; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Translate documents locally with Ollama",
    "longDescription": "An offline multilingual document translator for DOCX, PPTX, XLSX, Markdown, and UTF-8 TXT that preserves format-specific structure.",
    "windows": {
      "wix": { "language": "en-US" }
    }
  }
}
